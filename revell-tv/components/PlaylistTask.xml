<?xml version="1.0" encoding="utf-8" ?>
<component name="PlaylistTask" extends="Task">
    <interface>
        <field id="url" type="string" />
        <!-- this Roku's id, which Plex also needs -->
        <field id="clientId" type="string" />
        <field id="content" type="node" />
        <field id="popular" type="node" />
        <field id="penalty" type="node" />
        <field id="total" type="integer" value="0" />
        <field id="error" type="string" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/Plex.brs" />
    <script type="text/brightscript" uri="pkg:/components/PlaylistTask.brs" />
</component>
